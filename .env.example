# ── Database ──────────────────────────────────────────────
DATABASE_URL="postgresql://user:pass@localhost:5432/church_connect?schema=public"

# ── Auth (NextAuth) ───────────────────────────────────────
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-with: openssl rand -base64 32"

# ── WhatsApp Cloud API (platform default; per-church overrides live on Church) ──
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_BUSINESS_ACCOUNT_ID=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_VERIFY_TOKEN=""

# ── SMS (Termii primary, Twilio fallback) ─────────────────
TERMII_API_KEY=""
TERMII_SENDER_ID="ChurchCRM"
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM=""

# ── Email (Resend) ────────────────────────────────────────
RESEND_API_KEY=""
EMAIL_FROM="Church Connect <hello@example.com>"

# ── AI (Anthropic, follow-up suggestions) ─────────────────
ANTHROPIC_API_KEY=""

# ── Cron protection ───────────────────────────────────────
CRON_SECRET="generate-with: openssl rand -hex 32"

# ── Billing (Paystack) ────────────────────────────────────
PAYSTACK_SECRET_KEY=""
PAYSTACK_PUBLIC_KEY=""

# ── Media (Cloudinary) ────────────────────────────────────
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ── Misc ──────────────────────────────────────────────────
# Set to "true" to actually dispatch messages; otherwise they are logged only (dev-safe).
MESSAGING_LIVE="false"
